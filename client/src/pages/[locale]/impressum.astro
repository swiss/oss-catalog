---
import Layout from "@/layouts/Layout.astro";
import { type Lang, useTranslations } from "@/i18n/utils";
import PhoneIcon from "@/components/PhoneIcon.astro";
import EmailIcon from "@/components/EmailIcon.astro";
import { locales } from "@/i18n/locales";

export async function getStaticPaths() {
  return Object.keys(locales).map((locale) => ({
    params: { locale },
  }));
}

const t = useTranslations(Astro.currentLocale as Lang);
---

<Layout>
  <Fragment slot="opengraph">
    <title>{t("impressum.title")}</title>
    <meta property="og:title" content={t("index.title")} />
    <meta property="og:description" content={t("index.subtitle")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    <meta
      property="og:image"
      content={Astro.url.origin + "/favicon-128x128.png"}
    />
    <meta property="og:image:width" content="128" />
    <meta property="og:image:height" content="128" />
    <meta property="og:image:alt" content={t("index.title")} />
  </Fragment>
  <section class="section bg--secondary-50">
    <div class="container">
      <h1 class="section__title">{t("impressum.title")}</h1>
    </div>
  </section>
  <section class="container section--default vertical-spacing">
    <h2 class="h2">
      {t("impressum.content")}
    </h2>
    <address>
      Bundeskanzlei<br />
      Bundeshaus<br />
      3003 Bern<br /><br />

      <a href="tel: +41 58 46 22111" class="btn btn--link btn--icon-left">
        <PhoneIcon />
        <span class="btn__text">+41 58 46 22111</span>
      </a><br />
      <a
        href="mailto:opensource@bk.admin.ch"
        class="btn btn--link btn--icon-left"
      >
        <EmailIcon />
        <span class="btn__text">opensource@bk.admin.ch</span>
      </a><br />
    </address>

    <h2 class="h2">
      {t("impressum.design")}
    </h2>
    <address>
      Puzzle ITC AG<br />
      Belpstrasse 37<br />
      3007 Bern<br />
    </address>
  </section>
</Layout>
