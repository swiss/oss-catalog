---
import Layout from "@/layouts/Layout.astro";
import SoftwareDetail from "@/components/SoftwareDetail.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { type Lang, resolveLanguage, useTranslations } from "@/i18n/utils";
import type { PubliccodeYml, Software } from "@/lib/software";
import { load } from "js-yaml";
import { hashUrl } from "@/utils/hash";
import { getSoftwares } from "@/lib/software";
import { locales } from "@/i18n/locales";

export async function getStaticPaths() {
  const softwares = await getSoftwares();

  return softwares.flatMap((software) =>
    Object.keys(locales).map((locale) => ({
      params: {
        locale,
        id: hashUrl(software.url),
      },
      props: {
        software,
      },
    })),
  );
}

const software: Software = {
  ...Astro.props.software,
  publiccode: load(
    Astro.props.software.publiccodeYml as unknown as string,
  ) as PubliccodeYml,
};

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
const homeUrl = getRelativeLocaleUrl(lang);

const availableLanguages = Object.keys(software.publiccode?.description ?? {});
const softwareDescription =
  software.publiccode?.description?.[resolveLanguage(lang, availableLanguages)];
const softwareName = software.publiccode.name;
---

<style></style>

<Layout
  title={softwareName}
  description={softwareDescription?.shortDescription ?? ""}
>
  <div class="container pt-8">
    <a
      id="back-to-catalog"
      href={homeUrl}
      class="btn btn--outline btn--sm btn--icon-left btn--back"
      ><svg
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        class="icon icon--base icon--ArrowLeft btn__icon"
        ><path
          xmlns="http://www.w3.org/2000/svg"
          d="m8.306 5.116-4.066 7.044 4.066 7.044.65-.375-3.633-6.294h15.187v-.75h-15.187l3.633-6.294z"
        ></path></svg
      ><span class="btn__text">{t("software.back")}</span></a
    >
  </div>
  <div class="container vertical-spacing">
    <h1 class="h2">{t("software.title")}</h1>
    <SoftwareDetail software={software} />
  </div>
</Layout>

<script>
  // Going back through the history preserves the filters the user had set on
  // the catalog. Only do so when we actually came from this site, otherwise
  // fall back to the plain catalog link in the href.
  const backLink = document.getElementById("back-to-catalog");
  const cameFromThisSite =
    document.referrer !== "" &&
    new URL(document.referrer).origin === location.origin;

  if (backLink && cameFromThisSite && history.length > 1) {
    backLink.addEventListener("click", (event) => {
      event.preventDefault();
      history.back();
    });
  }
</script>
